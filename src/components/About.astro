---
import { config } from "../config";

const facts = [
  { k: "Опыт", v: "8 лет, с 2018" },
  { k: "Серверов", v: "50+ одновременно" },
  { k: "Кластеров", v: "2 в продакшене" },
  { k: "Команда", v: "до 5 инженеров" },
  { k: "Стек", v: "Kubernetes, Terraform, Ansible, Linux" },
  { k: "Языки", v: "русский, английский (технический)" },
  { k: "Формат", v: "удалённо, редкие командировки" },
];
---

<section id="about" class="border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]">
  <div class="mx-auto w-full max-w-[1240px] px-6 py-16 md:px-10 md:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="mono text-muted">06 — кто я</p>
        <h2 class="mt-4 text-[clamp(28px,4.2vw,46px)] font-semibold leading-[1.05] tracking-[-0.03em]">
          Иван Раенко
        </h2>

        <div class="mt-6 space-y-4 text-[16px] leading-relaxed text-ink/80">
          <p>
            Восемь лет строю инфраструктуру. Начинал в 2018-м с серверов и Linux, последние шесть лет работал
            в продуктовой компании Movavi — от ведущего инженера до руководителя отдела внешней инфраструктуры
            с командой из пяти человек.
          </p>
          <p>
            Последние три года делаю платформы целиком: от создания виртуальной машины до политик безопасности
            и дежурства. Люблю, когда систему можно пересобрать по репозиторию, а не по чьей-то памяти.
          </p>
          <p>
            Объясняю по-человечески: если после разговора осталось непонятно, что я сделал и зачем, — это моя
            вина, а не ваша.
          </p>
        </div>

        <a
          href={config.portfolio.url}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 border-b border-ink/30 pb-1 text-[15px] transition-colors hover:border-ink"
        >
          Открытый репозиторий с платформой — как я строю
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="lg:col-span-5">
        <dl class="border-t border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]">
          {
            facts.map((fact) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] py-3">
                <dt class="mono text-muted">{fact.k}</dt>
                <dd class="text-right text-[14px] leading-snug">{fact.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
