---
import { services } from "../data/services";
---

<section id="services" class="border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]">
  <div class="mx-auto w-full max-w-[1240px] px-6 py-16 md:px-10 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-[62ch]">
        <p class="mono text-muted">02 — услуги</p>
        <h2 class="mt-4 text-[clamp(28px,4.2vw,46px)] font-semibold leading-[1.05] tracking-[-0.03em]">
          Что я делаю
        </h2>
      </div>
      <p class="max-w-[34ch] text-[15px] leading-relaxed text-ink/70">
        Семь направлений. Можно взять одно, можно целиком — от установки сервера до дежурства.
      </p>
    </div>

    <div class="mt-10 grid gap-x-16 md:grid-cols-2">
      {
        services.map((service) => (
          <article class="service" data-pains={service.pains.join(",")} id={`service-${service.id}`}>
            <div class="flex items-baseline gap-3">
              <span class="mono text-muted">{service.num}</span>
              <h3 class="font-display text-[19px] font-semibold leading-tight tracking-[-0.02em] md:text-[21px]">
                {service.title}
              </h3>
              <span class="related-flag mono" aria-hidden="true">ваша боль</span>
            </div>

            <p class="mt-3 max-w-[46ch] text-[15px] leading-relaxed text-ink/75">{service.lead}</p>

            <ul class="mt-5 space-y-2">
              {service.includes.map((item) => (
                <li class="relative pl-6 text-[14.5px] leading-snug text-ink/85">
                  <span class="marker absolute left-0 top-0 font-mono text-[13px]" aria-hidden="true">
                    +
                  </span>
                  {item}
                </li>
              ))}
            </ul>

            <p class="meta mt-5">{service.whom}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-12 max-w-[70ch] border-t border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] pt-6 text-[15px] leading-relaxed text-ink/70">
      Не нашли свою ситуацию? Опишите в двух словах — скажу, это вообще ко мне или нет. Если нет, подскажу,
      к кому идти.
    </p>
  </div>
</section>
