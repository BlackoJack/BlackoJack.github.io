---
import { config } from "../config";
import Schematic from "./Schematic.astro";
---

<section id="top" class="border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]">
  <div class="mx-auto w-full max-w-[1240px] px-6 pb-16 pt-14 md:px-10 md:pb-24 md:pt-16">
    <p class="mono flex items-center gap-3 text-muted">
      <span class="inline-block h-2 w-2 rounded-full bg-lime ring-4 ring-lime/25" aria-hidden="true"></span>
      DevOps · инфраструктура · удалённо
    </p>

    <h1 class="mt-7 text-[clamp(32px,6.1vw,86px)] font-semibold leading-[0.95] tracking-[-0.04em]">
      Инфраструктура, которая не падает
    </h1>

    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <p class="max-w-[54ch] text-[17px] leading-relaxed text-ink/80 md:text-[18px]">
          Меня зовут {config.shortName}. Я отвечаю за то, чтобы сайт и приложения работали, обновлялись без страха
          и не теряли данные. Восемь лет в этом, шесть из них — в продуктовой компании, где под присмотром было
          больше пятидесяти серверов.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={config.contacts.telegram.url} class="btn btn-lime" target="_blank" rel="noopener">
            Написать в Telegram
            <span aria-hidden="true">→</span>
          </a>
          <a href="#services" class="btn btn-ghost">Что я умею</a>
        </div>

        <p class="mono mt-7 text-muted">Первый разговор — 30 минут, бесплатно</p>

        <dl class="mt-10 grid max-w-[520px] grid-cols-3 gap-4 border-t border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] pt-5">
          <div>
            <dt class="mono text-muted">Опыт</dt>
            <dd class="mt-1 font-display text-[20px] font-semibold">8 лет</dd>
          </div>
          <div>
            <dt class="mono text-muted">Серверов</dt>
            <dd class="mt-1 font-display text-[20px] font-semibold">50+</dd>
          </div>
          <div>
            <dt class="mono text-muted">Кластеров</dt>
            <dd class="mt-1 font-display text-[20px] font-semibold">2</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-5">
        <Schematic />
        <p class="mono mt-4 text-muted">Схема интерактивная — кликните по блоку</p>
      </div>
    </div>
  </div>
</section>
