---
import { config } from "../config";

const { wordmark } = config.brand;
---

<header class="sticky top-0 z-40 border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-[1240px] items-center justify-between px-6 md:px-10">
    <a href="#top" class="group flex items-center gap-3" aria-label={`${wordmark} — ${config.brand.tagline}`}>
      <span
        class="grid h-9 w-9 place-items-center bg-lime transition-transform duration-200 group-hover:-rotate-3"
        aria-hidden="true"
      >
        <svg viewBox="0 0 36 36" class="h-9 w-9" role="presentation">
          <path
            d="M5.5 18.5h5.6l3.1-6.6 3.9 12.6 2.9-8.4 2 2.4h6.5"
            fill="none"
            stroke="#111214"
            stroke-width="2.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="font-display text-[17px] font-semibold lowercase tracking-[-0.03em]">{wordmark}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Разделы">
      <a href="#services" class="text-[14px] text-ink/80 transition-colors hover:text-ink">Услуги</a>
      <a href="#cases" class="text-[14px] text-ink/80 transition-colors hover:text-ink">Кейсы</a>
      <a href="#faq" class="text-[14px] text-ink/80 transition-colors hover:text-ink">Вопросы</a>
    </nav>

    <a href="#contact" class="btn btn-lime !py-2.5 !text-[11px]">Написать</a>
  </div>
</header>
