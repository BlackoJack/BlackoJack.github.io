---
import "../styles/global.css";
import { config } from "../config";

const { title, description } = config.meta;
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL(config.siteUrl);
const canonical = new URL(Astro.url.pathname, origin).toString();
const ogUrl = new URL(`${base}og.png`, origin).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: `${config.brand.wordmark} — ${config.role}`,
  slogan: config.brand.tagline,
  description,
  url: config.siteUrl,
  areaServed: "RU",
  availableLanguage: "ru",
  sameAs: [config.contacts.telegram.url, config.contacts.github.url],
  founder: {
    "@type": "Person",
    name: config.name,
    jobTitle: config.role,
    url: config.portfolio.url,
  },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#f1eee7" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="grain antialiased">
    <a
      href="#services"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Перейти к содержанию
    </a>
    <slot />
  </body>
</html>
